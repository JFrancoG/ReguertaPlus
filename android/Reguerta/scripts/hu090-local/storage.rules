rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{path=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in [
        'qa.member@example.invalid', 'qa.producer@example.invalid', 'qa.admin@example.invalid'
      ] && (request.resource == null || request.resource.size < 5 * 1024 * 1024);
    }
  }
}
